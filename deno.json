{
  "tasks": {
    "cek": "deno run --allow-read src/main.ts cek",
    "cari": "deno run --allow-read src/main.ts cari",
    "tampil": "deno run --allow-read src/main.ts tampil",
    "laporan": "deno run --allow-read --allow-write src/main.ts laporan docs/laporan.md",
    "bangun": "deno run --allow-read --allow-write src/main.ts bangun _site",
    "uji": "deno test --allow-read --allow-write"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/toml": "jsr:@std/toml@^1.0.0"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["_site/", "docs/laporan.md"]
  },
  "lint": {
    "exclude": ["_site/"]
  }
}
